{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores core details for authenticated customers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "whatsapp": { "type": "string", "minLength": 8, "maxLength": 20 },
        "whatsappClean": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "whatsapp", "email", "createdAt", "updatedAt"]
    },
    "Address": {
      "title": "Customer Address",
      "description": "Saved delivery addresses (Home, Work, etc.) for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "street": { "type": "string", "minLength": 3, "maxLength": 150 },
        "number": { "type": "string", "minLength": 1, "maxLength": 10 },
        "complement": { "type": "string", "maxLength": 100 },
        "neighborhood": { "type": "string", "minLength": 2, "maxLength": 100 },
        "label": { "type": "string", "enum": ["casa", "trabalho", "outro"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "street", "number", "neighborhood", "label", "createdAt", "updatedAt"]
    },
    "CompanySettings": {
      "title": "Company Settings",
      "description": "Global restaurant settings including WhatsApp, PIX, and admin access",
      "type": "object",
      "properties": {
        "whatsappNumber": { "type": "string" },
        "phone": { "type": "string" },
        "pixKey": { "type": "string" },
        "pixKeyType": { "type": "string" },
        "pixBeneficiary": { "type": "string" },
        "adminUser": { "type": "string" },
        "adminPass": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "MenuItem": {
      "title": "Menu Item",
      "description": "Custom dishes and products added or edited through the admin panel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "isPopular": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "categoryId", "price"]
    },
    "Order": {
      "title": "Customer Order",
      "description": "Restaurant order placed by a customer for delivery or pickup",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerPhoneClean": { "type": "string" },
        "customerId": { "type": "string" },
        "deliveryType": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "itemsSubtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "grandTotal": { "type": "number" },
        "status": { "type": "string" },
        "schedule": { "type": "object" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "customerName", "customerPhone", "deliveryType", "paymentMethod", "grandTotal"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles containing base contact information"
    },
    "users/{userId}/addresses/{addressId}": {
      "schema": "Address",
      "description": "Saved delivery locations for faster checkouts"
    },
    "app_settings/{settingId}": {
      "schema": "CompanySettings",
      "description": "General restaurant settings and configuration"
    },
    "menu_items/{itemId}": {
      "schema": "MenuItem",
      "description": "Custom dishes created by the admin"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Orders placed by customers"
    }
  }
}

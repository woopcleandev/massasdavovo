rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default catch-all deny rule for total safety
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profile Validation ---
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'whatsapp', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'whatsapp', 'whatsappClean', 'email', 'createdAt', 'updatedAt', 'id'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.whatsapp is string && data.whatsapp.size() >= 8 && data.whatsapp.size() <= 20
        && (!data.keys().contains('whatsappClean') || (data.whatsappClean is string && data.whatsappClean.size() <= 20))
        && data.email is string && data.email.size() <= 150
        && data.updatedAt == request.time;
    }

    // --- Saved Address Validation ---
    function isValidAddress(data, authUid) {
      return data.keys().hasAll(['userId', 'street', 'number', 'neighborhood', 'label', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'street', 'number', 'complement', 'neighborhood', 'label', 'createdAt', 'updatedAt', 'id'])
        && data.userId == authUid
        && data.street is string && data.street.size() >= 3 && data.street.size() <= 150
        && data.number is string && data.number.size() >= 1 && data.number.size() <= 10
        && (!data.keys().contains('complement') || (data.complement is string && data.complement.size() <= 100))
        && data.neighborhood is string && data.neighborhood.size() >= 2 && data.neighborhood.size() <= 100
        && data.label is string && (data.label == 'casa' || data.label == 'trabalho' || data.label == 'outro')
        && data.updatedAt == request.time;
    }

    // --- Firestore Collection Matches ---

    // User collection path rules
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming())
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId)
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'whatsapp', 'whatsappClean', 'updatedAt'])
            && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 100
            && incoming().whatsapp is string && incoming().whatsapp.size() >= 8 && incoming().whatsapp.size() <= 20
            && incoming().updatedAt == request.time)
          ||
          (isValidUser(incoming())
            && incoming().createdAt == existing().createdAt)
        );
      allow delete: if false; // Deletion is not allowed from the client for security

      // Saved Address subcollection rules
      match /addresses/{addressId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(addressId);
        allow create: if isOwner(userId) && isValidId(addressId) && isValidAddress(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if isOwner(userId) && isValidId(addressId)
          && (
            (incoming().diff(existing()).affectedKeys().hasOnly(['street', 'number', 'complement', 'neighborhood', 'label', 'updatedAt'])
              && incoming().street is string && incoming().street.size() >= 3 && incoming().street.size() <= 150
              && incoming().number is string && incoming().number.size() >= 1 && incoming().number.size() <= 10
              && (!incoming().keys().contains('complement') || (incoming().complement is string && incoming().complement.size() <= 100))
              && incoming().neighborhood is string && incoming().neighborhood.size() >= 2 && incoming().neighborhood.size() <= 100
              && incoming().label is string && (incoming().label == 'casa' || incoming().label == 'trabalho' || incoming().label == 'outro')
              && incoming().updatedAt == request.time)
            ||
            (isValidAddress(incoming(), userId)
              && incoming().createdAt == existing().createdAt)
          );
        allow delete: if isOwner(userId) && isValidId(addressId);
      }
    }

    // App settings (company WhatsApp, PIX configuration, and Master Admin preferences)
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Custom menu items added or modified by the restaurant
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Customer orders placed via delivery, pickup or POS
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Cash movements (suprimentos e sangrias)
    match /cash_movements/{movementId} {
      allow read: if true;
      allow write: if true;
    }

    // Custom dish categories created by the restaurant
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
